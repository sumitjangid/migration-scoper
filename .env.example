# AI output is disabled by default.
AI_ENABLED=false

# Vercel AI Gateway model in provider/model format.
# Choose a model marked free-tier eligible in the Vercel dashboard.
AI_MODEL=

# Local development only. Deployed environments should use Vercel OIDC.
AI_GATEWAY_API_KEY=

# Daily AI-enriched reports per IP.
AI_MAX_REPORTS_PER_IP_PER_DAY=3
